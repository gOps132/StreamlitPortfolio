# Copy this file to `.streamlit/secrets.toml` for local development.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# `.streamlit/secrets.toml` is gitignored. On Render these same values live
# in the service's Environment tab instead.

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY = "re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Where contact form submissions should be delivered.
CONTACT_TO_EMAIL = "you@example.com"

# Optional. Defaults to "Portfolio <onboarding@resend.dev>", which Resend only
# allows to be delivered to the email address on your own Resend account.
# Set this once you have a verified domain, e.g.
# RESEND_FROM = "Portfolio <portfolio@yourdomain.com>"
